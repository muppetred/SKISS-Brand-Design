{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/blocks/**",
              "components/brand/**",
              "components/core/**",
              "export/**",
              "ui_kits/deck/**",
              "ui_kits/documents/**",
              "ui_kits/social/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Khand|Hind))/i]",
        "message": "Font not provided by the design system. Available: Khand, Hind."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentWord'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|children|key|ref|className|style|children)$/]",
        "message": "<AccentWord> doesn't accept that prop. Declared props: as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|as|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:soft|solid|outline)$/]",
        "message": "<Badge> tone must be one of 'soft' | 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|as|state|disabled|type|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, as, state, disabled, type, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|gradient)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'gradient'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:hover|focus)$/]",
        "message": "<Button> state must be one of 'hover' | 'focus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Capsule'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Capsule> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:elevated|interactive|as|href|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: elevated, interactive, as, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|state|disabled|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, state, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:focus)$/]",
        "message": "<Input> state must be one of 'focus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyFigure'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|caption|align|key|ref|className|style|children)$/]",
        "message": "<KeyFigure> doesn't accept that prop. Declared props: value, caption, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyFigure'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<KeyFigure> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|height|src|alt|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, tone, height, src, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:vertical|horizontal|bulb|spiral|wordmark|baseline)$/]",
        "message": "<Logo> variant must be one of 'vertical' | 'horizontal' | 'bulb' | 'spiral' | 'wordmark' | 'baseline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:black|white)$/]",
        "message": "<Logo> tone must be one of 'black' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|label|shade|icon|key|ref|className|style|children)$/]",
        "message": "<NumberedCard> doesn't accept that prop. Declared props: number, label, shade, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:format|theme|shapes|signature|signatureTone|signatureSrc|scale|children|key|ref|className|style|children)$/]",
        "message": "<PostFrame> doesn't accept that prop. Declared props: format, theme, shapes, signature, signatureTone, signatureSrc, scale, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:post|reel)$/]",
        "message": "<PostFrame> format must be one of 'post' | 'reel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:social|light|cream|dark|burnt)$/]",
        "message": "<PostFrame> theme must be one of 'social' | 'light' | 'cream' | 'dark' | 'burnt'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute[name.name='signatureTone'] > Literal[value!=/^(?:auto|white|black)$/]",
        "message": "<PostFrame> signatureTone must be one of 'auto' | 'white' | 'black'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:service|duration|price|key|ref|className|style|children)$/]",
        "message": "<PriceRow> doesn't accept that prop. Declared props: service, duration, price."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|key|ref|className|style|children)$/]",
        "message": "<ProcessStep> doesn't accept that prop. Declared props: title, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|author|spiral|spiralTone|src|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: children, author, spiral, spiralTone, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute[name.name='spiralTone'] > Literal[value!=/^(?:auto|black|white)$/]",
        "message": "<Quote> spiralTone must be one of 'auto' | 'black' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:auto|white)$/]",
        "message": "<SectionTitle> tone must be one of 'auto' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Signature'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|tone|layout|src|alt|key|ref|className|style|children)$/]",
        "message": "<Signature> doesn't accept that prop. Declared props: height, tone, layout, src, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Signature'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:black|white)$/]",
        "message": "<Signature> tone must be one of 'black' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Signature'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:page|nav)$/]",
        "message": "<Signature> layout must be one of 'page' | 'nav'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|title|signature|signatureTone|signatureSrc|scale|children|key|ref|className|style|children)$/]",
        "message": "<SlideFrame> doesn't accept that prop. Declared props: theme, title, signature, signatureTone, signatureSrc, scale, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:gradient|burnt|dark|light|cream)$/]",
        "message": "<SlideFrame> theme must be one of 'gradient' | 'burnt' | 'dark' | 'light' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute[name.name='signatureTone'] > Literal[value!=/^(?:auto|white|black)$/]",
        "message": "<SlideFrame> signatureTone must be one of 'auto' | 'white' | 'black'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepChevrons'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|height|key|ref|className|style|children)$/]",
        "message": "<StepChevrons> doesn't accept that prop. Declared props: steps, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|as|children|key|ref|className|style|children)$/]",
        "message": "<ThemeSection> doesn't accept that prop. Declared props: theme, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeSection'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark|gradient|burnt|social|cream)$/]",
        "message": "<ThemeSection> theme must be one of 'light' | 'dark' | 'gradient' | 'burnt' | 'social' | 'cream'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
